# =============================================
# AEMS V5 - Git Ignore
# Only source code, no build artifacts
# =============================================

# ------------------
# .NET Backend
# ------------------
# Build outputs
bin/
obj/
*.dll
*.pdb
*.exe
*.deps.json
*.runtimeconfig.json

# Publish outputs
publish/

# Visual Studio / VS Code
.vs/
*.user
*.suo

# Logs
logs/
*.log

# Uploads
uploads/

# Local SQLite database
*.db
*.db-journal

# Secrets & local config
appsettings.json
appsettings.Development.json
!appsettings.example.json

# ------------------
# Node.js Frontend
# ------------------
# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-all/
*.tgz

# Local env files (may contain secrets)
.env
.env.*
!.env.example

# ------------------
# OS / Editor
# ------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ------------------
# Misc
# ------------------
*.bak
*.tmp
